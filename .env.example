# BrewMaster — Cloud Sync Configuration (TEMPLATE)
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the real values.
# NEVER commit a real `.env` or real secrets to the repository.

# Cloud API base URL (Cloudflare Worker → D1 database brewmaster-db)
VITE_CF_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# ⚠️  DEPRECATED — do NOT put shared API keys here.
# Branch POS keys are now per-branch secrets stored in the OS-keychain-
# encrypted settings store (Settings → Branch), and the manager web portal
# authenticates with email/password (JWT) instead of any shared key.
# This variable only remains so very old installs can be upgraded; delete it.
# VITE_CF_WORKER_API_KEY=
