# Engaz — configuration template
# ─────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; nothing here should hold a real value.
#
# A note on VITE_ variables: Vite inlines them into the built bundle at build time, so any
# VITE_ value is public to anyone who opens the app. Only the desktop build is trusted with
# a key, because its bundle is not served to visitors.

# ── Production POS database worker ────────────────────────────────────────────
VITE_CF_WORKER_URL=https://api.engaz.tech

# Write key for the POS worker, set as the worker's WORKER_API_KEY secret:
#   npx wrangler secret put WORKER_API_KEY
#
# ⚠️ This value is read by the Electron main process (electron/mockApiService.cjs) at
# runtime from this file. Despite the VITE_ prefix (kept for compatibility), the app
# sources never reference it, so it is NOT inlined into any bundle. Do not import it
# through import.meta.env anywhere in src/ — the root bundle is served publicly on
# menu.engaz.tech, and any VITE_ value referenced by src/ is published to every visitor.
VITE_CF_WORKER_API_KEY=your_production_worker_api_key

# ── Reports portal (reporting.engaz.tech) — isolated database ─────────────────
# The desktop POS mirrors its records here, so the portal reads from its own database and
# never touches the production POS one.
VITE_REPORTS_WORKER_URL=https://api-reports.engaz.tech

# Write key for the reports worker. Desktop only; the portal ships no key at all.
# Same rule as above: read at runtime by the Electron main process, never referenced
# through import.meta.env in src/.
VITE_REPORTS_API_KEY=your_reports_worker_write_key

# Password a portal visitor signs in with, set as the worker's REPORTS_VIEWER_PASSWORD
# secret. The portal exchanges it for a short-lived read-only token.
REPORTS_VIEWER_PASSWORD=your_viewer_password

# Signs those read-only tokens. Any long random string; rotating it signs everyone out.
REPORTS_TOKEN_SECRET=your_long_random_token_secret

# Separate password for editing the branch registry (reports worker secret
# REPORTS_BRANCH_PASSWORD).
#
# ⚠️ AUTHORISATION, NOT COSMETICS: while this is unset, a *read-only* viewer token is also
# accepted by /branches/save and /branches/delete, so anyone who can merely view reports can
# rename and delete branches — the identifier every mirrored row is filtered by. Set it, and
# read tokens stop being able to write.
REPORTS_BRANCH_PASSWORD=your_branch_registry_password

# ── Optional / advanced ──────────────────────────────────────────────────────
# Undocumented until 2026-09-15. Each of these changes behaviour and has a default, so
# leaving them unset is safe — but an operator reading only this file could not know they
# exist.

# Preferred name for the reports write key above (read first, before VITE_REPORTS_API_KEY).
ENGAZ_REPORTS_API_KEY=

# Public URL printed on QR codes for the customer menu. Defaults to https://menu.engaz.tech.
VITE_PUBLIC_MENU_URL=https://menu.engaz.tech

# Rate-limit budgets per minute: anonymous callers, then callers holding a valid API key.
# Defaults 120 / 600. Raise the second one first if tills are seeing spurious 429s.
RATE_MAX_REQUESTS=120
SYNC_RATE_MAX_REQUESTS=600

# Allow localhost origins through CORS (POS worker). "false" in production.
ALLOW_DEV_ORIGINS=false

# Desktop development switches. ENGAZ_DEV_LOAD_URL loads an arbitrary remote URL with the
# preload bridge attached — never set it on a till.
ENGAZ_DEV=
ENGAZ_DEV_LOAD_URL=
# Comma-separated hostnames the desktop client is allowed to send the API key to.
ENGAZ_ALLOWED_WORKER_HOSTS=
# Comma-separated DNS servers, for networks whose resolver cannot reach the worker.
ENGAZ_DNS_SERVERS=

# ── Deployment only ──────────────────────────────────────────────────────────
# Cloudflare token with Workers, D1 and Pages permissions. Used by deploy-reports.ps1 and
# never read by the application.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
