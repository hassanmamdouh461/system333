# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuxt.js build output
.nuxt

# gatsby files
.cache/
public/

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# Mac OS
.DS_Store

# Windows
Thumbs.db

/dist
/dist-menu
/git-install.exe
/mingit/
/scratch/
/dist-electron

# Build archives. dist-deploy.zip was committed three separate times before this rule
# existed, so the pattern is what keeps it out rather than a one-off deletion.
*.zip

# Wrangler deploy scratch directory
.wrangler/

# Reports portal (reporting.engaz.tech) — build artifacts and deps
reports-site/node_modules/
reports-site/dist/
reports-site/.env

# Host deploy scratch directories (login state, project links — never commit)
.netlify/
.vercel/

# Assistant session state. Never commit: the workspace copy holds a production database
# export under .workbuddy-ai/backups/, alongside transcripts that mention live endpoints.
.workbuddy-ai/
.zcode/

# Audit and diagnostic scratch. One `git add .` used to be enough to commit hundreds of
# kilobytes of captured live bundles, database dumps and generated dossiers — some of which
# contained a production credential that was captured precisely because it had leaked.
/outputs/
/.postman/
/postman/

# Legacy static-host state from before the Cloudflare migration.
.turbo/
